# Keep the build context small and keep secrets out of image layers.

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/dist
**/build
**/out
**/coverage
**/.vite
**/*.tsbuildinfo

# Environment files: never copied into an image
.env
.env.*
!.env.example

# Version control, editor and OS files
.git
.github
.idea
.vscode
**/.DS_Store
**/Thumbs.db

# Logs and test artifacts
**/*.log
**/npm-debug.log*
**/pnpm-debug.log*
**/playwright-report
**/test-results
**/blob-report
e2e

# Local-only documentation (untracked by design) and compose overrides
docs
compose.override.yaml
docker-compose.override.yml

# Key material
**/*.pem
**/*.key
