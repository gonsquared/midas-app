# Midas environment template (PLANNED: nothing reads this file yet).
# Copy to .env for local development. Placeholders only; never commit real secrets.
# Source of truth: docs/architecture.md section 10 and docs/database.md section 15.2.

# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_BASE_URL=http://localhost:5173
TRUST_PROXY=0

# --- Database ---
DATABASE_URL=postgres://midas_app:change-me-local-only@localhost:5432/midas
# Optional: owner role, direct connection. Defaults to DATABASE_URL.
DATABASE_MIGRATION_URL=postgres://midas_owner:change-me-local-only@localhost:5432/midas
# Optional: only for the audit retention purge task.
DATABASE_MAINTENANCE_URL=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
# off | require | verify-full (default verify-full in production, off otherwise)
DATABASE_SSL=off
DATABASE_SSL_CA=
AUDIT_RETENTION_DAYS=400
# Optional: password for dev seed accounts (development only). Random if unset.
SEED_DEMO_PASSWORD=
# Optional: Testcontainers image for integration tests.
TEST_DATABASE_IMAGE=postgres:17-bookworm

# --- Local Compose database container only ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=midas
MIDAS_APP_DB_PASSWORD=change-me-local-only

# --- Auth ---
# At least 32 random bytes, for example: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-generate-a-long-random-value
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90
AUDIT_HMAC_SECRET=change-me-generate-a-long-random-value

# --- Mail (smtp | console | memory) ---
MAIL_TRANSPORT=smtp
MAIL_FROM=Midas <no-reply@example.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Scheduler (recurring transactions) ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
RECURRING_MAX_CATCHUP=31
RECURRING_MAX_FAILURES=5

# --- Rate limits (per-route overrides: TODO, defined during implementation) ---
RATE_LIMIT_ENABLED=true

# --- CORS (development only) ---
CORS_ORIGINS=http://localhost:5173

# --- Observability ---
# /metrics is disabled when unset.
METRICS_TOKEN=

# --- Bootstrap (optional, one-time) ---
BOOTSTRAP_ADMIN_EMAIL=

# --- Test only (honoured only when NODE_ENV=test) ---
# CLOCK_OVERRIDE=
