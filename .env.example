# Midas environment template. apps/api loads ../../.env in development (node --env-file-if-exists).
# Copy to .env for local development. Placeholders only; never commit real secrets.
# Source of truth: architecture notes section 10 and database design notes section 15.2.

# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public URL of the app, used in reset links. Required in production and must be https.
APP_BASE_URL=http://localhost:5173
TRUST_PROXY=0
# Bind address and reported version (shown by GET /health).
HOST=0.0.0.0
APP_VERSION=0.0.0

# --- Database ---
DATABASE_URL=postgres://midas_app:change-me-local-only@localhost:5432/midas
# Optional: owner role, direct connection. Defaults to DATABASE_URL.
DATABASE_MIGRATION_URL=postgres://midas_owner:change-me-local-only@localhost:5432/midas
# Optional: only for the audit retention purge task.
DATABASE_MAINTENANCE_URL=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
# off | require | verify-full (default verify-full in production, off otherwise)
DATABASE_SSL=off
DATABASE_SSL_CA=
AUDIT_RETENTION_DAYS=400
# Optional: password for dev seed accounts (development only). Random if unset.
SEED_DEMO_PASSWORD=
# Optional: Testcontainers image for integration tests.
TEST_DATABASE_IMAGE=postgres:17-bookworm
# Optional: admin URL of an existing PostgreSQL 17 server for integration tests (used instead of
# Testcontainers; a throwaway database is created and dropped). Tests skip when neither is available.
TEST_DATABASE_URL=

# --- Local Compose database container only (compose.yaml; see database design notes 15.1) ---
# POSTGRES_USER is the owner role that runs migrations (DATABASE_MIGRATION_URL above).
POSTGRES_USER=midas_owner
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=midas
MIDAS_APP_DB_PASSWORD=change-me-local-only

# --- Auth ---
# At least 43 characters (32 random bytes, base64). The placeholder below is rejected outside NODE_ENV=test;
# generate a value, for example: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-generate-a-long-random-value
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90
AUDIT_HMAC_SECRET=change-me-generate-a-long-random-value

# --- Mail (smtp | console | memory) ---
# smtp talks to Mailpit locally (docker compose starts it; UI on http://localhost:8025).
# console only logs recipient and subject (the body too in development) and needs no server.
# memory is for tests. Production requires smtp. Defaults to memory under NODE_ENV=test, else smtp.
MAIL_TRANSPORT=smtp
MAIL_FROM=Midas <no-reply@example.com>
SMTP_HOST=localhost
SMTP_PORT=1025
# true = implicit TLS (port 465). In production with false, STARTTLS is mandatory and the
# server certificate is verified; local dev (Mailpit) stays plaintext-friendly.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Scheduler (recurring transactions) ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
RECURRING_MAX_CATCHUP=31
RECURRING_MAX_FAILURES=5

# --- Rate limits ---
RATE_LIMIT_ENABLED=true
# POST /api/v1/auth/register: attempts per IP per window (default 5 per hour).
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
# Other maximums per fixed window (defaults follow architecture 9):
# per IP + email, per minute
RATE_LIMIT_LOGIN_MAX=5
# per IP, per minute
RATE_LIMIT_LOGIN_IP_MAX=20
# per account (email hash, any IP), per hour; caps distributed credential stuffing
RATE_LIMIT_LOGIN_ACCOUNT_MAX=20
# per email hash, per hour
RATE_LIMIT_FORGOT_EMAIL_MAX=3
# per IP, per hour
RATE_LIMIT_FORGOT_IP_MAX=10
# reset and verify, per IP, per hour
RATE_LIMIT_RESET_MAX=10
# per session (IP when the cookie is missing or malformed), per minute
RATE_LIMIT_REFRESH_MAX=30
# per user, per hour
RATE_LIMIT_PASSWORD_CHANGE_MAX=10
# authenticated writes, per user, per minute
RATE_LIMIT_USER_WRITE_MAX=120
# authenticated reads, per user, per minute
RATE_LIMIT_USER_READ_MAX=600
# all /api requests, per IP, per minute
RATE_LIMIT_GLOBAL_IP_MAX=1200
# in-memory counters kept per limiter (LRU; each limiter has its own store)
RATE_LIMIT_STORE_MAX_KEYS=25000

# --- CORS (development only) ---
# Comma-separated origins (scheme://host[:port], no paths, no wildcard). Ignored in production,
# where the SPA is served from the API origin and no CORS headers are sent.
CORS_ORIGINS=http://localhost:5173

# --- Observability ---
# /metrics is disabled when unset.
METRICS_TOKEN=

# --- Bootstrap (optional, one-time) ---
BOOTSTRAP_ADMIN_EMAIL=

# --- Test only (honoured only when NODE_ENV=test) ---
# CLOCK_OVERRIDE=
