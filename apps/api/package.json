{
  "name": "@midas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "cli": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "migrate": "pnpm run cli migrate",
    "migrate:down": "pnpm run cli migrate:down",
    "migrate:status": "pnpm run cli migrate:status",
    "migrate:verify": "pnpm run cli migrate:verify",
    "db:migrate:create": "pnpm run cli migrate:create",
    "seed:system": "pnpm run cli seed:system",
    "db:codegen": "node --env-file-if-exists=../../.env node_modules/kysely-codegen/dist/cli/bin.js",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:perf": "vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@midas/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "^0.28.2",
    "kysely-codegen": "^0.20.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
